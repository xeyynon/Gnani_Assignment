# Dukaan Dost settings. Copy this file to .env (which is gitignored) and fill it in.
# Never commit .env. Lines are KEY=value. A blank value counts as not set.

# --- Keys -------------------------------------------------------------------------------
# Gnani: register at https://www.gnani.ai/internship, then get the key at
# https://app.gnani.ai/voice (5,000 credits on registration).
GNANI_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey (no Google Cloud project needed)
GEMINI_API_KEY=

# Groq (the language model while there is no Gemini key): https://console.groq.com/keys
GROQ_API_KEY=

# Password for the admin dashboard (user name "admin"). Shop PINs are set separately:
#   python -m dukaan_dost.auth set-pin <shop>
ADMIN_PASSWORD=

# --- Which speech models the agent uses --------------------------------------------------
# gnani = Prisma for listening / Timbre for speaking (needs GNANI_API_KEY).
# The older choices need their own credentials: STT_PROVIDER=sarvam|google, TTS_PROVIDER=google.
STT_PROVIDER=gnani
TTS_PROVIDER=gnani

# Which language model: groq or gemini. groq needs GROQ_API_KEY; gemini needs GEMINI_API_KEY.
LLM_PROVIDER=groq

# --- Optional ---------------------------------------------------------------------------
# SHOP_NAME=dukaan_dost
# LLM_MODEL=qwen/qwen3.8-27b     (the groq default; gemini-3.5-flash-lite is the gemini default)
# GNANI_TTS_VOICE=Shivani
# GNANI_STT_FORMAT=transcribe
