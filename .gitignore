# Secrets and per-machine settings (the shared template is local_config.example.py)
local_config.py
.env

# Runtime state, including the hashed shop PINs
data/

# Runtime output. Logs contain call transcripts, so none of it is committed.
*.log
*.log.*
logs/
call_data/
stt_dumps/

# Orders and ledgers the agent writes (synthetic samples go in orders/samples/)
orders/*
!orders/samples/

# Generated evaluation audio; the results tables in evaluation/results/ ARE committed
evaluation/audio/

# Python and tooling
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
node_modules/

# Browser-automation output (screenshots and logs from the Playwright tool)
.playwright-mcp/
