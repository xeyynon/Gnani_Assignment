# Secrets and per-machine settings (the shared template is local_config.example.py)
local_config.py
.env

# Runtime state, including the hashed shop PINs
data/

# Runtime output. Logs contain call transcripts, so none of it is committed.
*.log
*.log.*
logs/
call_data/
stt_dumps/

# Orders and ledgers the agent writes (synthetic samples go in orders/samples/)
orders/*
!orders/samples/

# Generated evaluation audio; the results tables in evaluation/results/ ARE committed
evaluation/audio/

# Python and tooling
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
node_modules/

# Browser-automation output (screenshots and logs from the Playwright tool)
.playwright-mcp/

# Private working notes stay on this machine. Only the public project docs in MD/ are committed:
# the allow-list below, plus the build reports in MD/builds/.
MD/*
!MD/architecture.md
!MD/ci_cd.md
!MD/deployment.md
!MD/external_research.md
!MD/flow.md
!MD/ml.md
!MD/phone_setup.md
!MD/prd.md
!MD/problem_statement.md
!MD/builds/
