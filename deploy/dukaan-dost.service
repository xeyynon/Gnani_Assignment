# dukaan-dost.service — systemd USER unit (not a system unit).
#
# Why a user service: with the Pipewire transport the app shells out to
# pw-record / pw-play / wpctl / pw-link, and PipeWire + WirePlumber run as
# PER-USER systemd services on the Pi. A system-level service wouldn't
# reliably see that user's PipeWire session; a user service runs inside the
# same session manager, so the After=/Wants= lines below just work.
#
# Install path: ~/.config/systemd/user/dukaan-dost.service
# See deploy/INSTALL.md for the full steps, including the one system-level
# command this needs (`sudo loginctl enable-linger <user>`) so it starts at
# boot with nobody logged in.

[Unit]
Description=Dukaan Dost — phone-order and loan-guidance voice agent
# Wants, not Requires: if PipeWire/WirePlumber are slow on a cold boot, retry
# (Restart= below) rather than refusing to start at all.
After=pipewire.service wireplumber.service pipewire-pulse.service network-online.target bluetooth.target
Wants=pipewire.service wireplumber.service pipewire-pulse.service

[Service]
Type=simple

# EDIT if the project lives somewhere else. Both paths must be the SAME
# checkout, and the app must be started from the project root so that
# `python -m dukaan_dost` and local_config.py are found.
WorkingDirectory=%h/projects/dukaan-dost
ExecStart=%h/projects/dukaan-dost/.venv/bin/python3 -m dukaan_dost

# Which folder under shops/ to run (default: dukaan_dost). Calls are never recorded.
Environment=SHOP_NAME=dukaan_dost
Environment=CALL_DATA_ENABLED=0

# Restart on a crash, but not in a tight loop if something is structurally
# broken (bad config, missing credentials): 5 s backoff, then give up
# escalating rather than hammering the speech and language-model APIs.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

# `journalctl --user -u dukaan-dost -f`. The app also writes dukaan_dost.log;
# this captures anything that reaches stdout/stderr first (e.g. a startup
# traceback before the app's own logging exists).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
